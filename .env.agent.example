# =============================================================================
# .env.agent — Configuração do Agente Autônomo de Incidentes
# =============================================================================
# NUNCA commitar este arquivo com valores reais.
# Copiar para .env.agent e preencher os valores.
# Garantir que .env.agent está no .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# MCP Servers (VM mcp-server — 192.168.10.210)
# ---------------------------------------------------------------------------
ZABBIX_MCP_URL=http://192.168.10.210:8080/mcp
K8S_MCP_URL=http://192.168.10.210:8081/mcp

# Bearer token do Zabbix MCP (se configurado)
ZABBIX_MCP_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# Canal de notificação
# telegram     → apenas Telegram
# google_chat  → apenas Google Chat
# both         → Telegram + Google Chat
# ---------------------------------------------------------------------------
NOTIFICATION_CHANNEL=telegram

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# Google Chat (produção)
GOOGLE_CHAT_WEBHOOK_URL=CHANGE_ME

# ---------------------------------------------------------------------------
# Servidor webhook
# ---------------------------------------------------------------------------
WEBHOOK_PORT=9000

# Secret para validar requisições do Zabbix (recomendado)
WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS
