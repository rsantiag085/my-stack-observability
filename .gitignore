# =============================================================================
# Secrets — variáveis de ambiente
# Ignora QUALQUER .env e variante (.env.local, .env.prod, .env.bak, .env~ ...),
# mantendo apenas os templates *.example. Cobertura por padrão, não por nome.
# =============================================================================
.env*
!.env.example
!.env.*.example
*.env

# Chaves privadas e SSH (caso alguma seja copiada para dentro do repo)
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
*.ppk

# Certificados e keystores
config/nginx/certs/
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore

# Zabbix — chaves PSK do agente/proxy (TLS)
*.psk

# Ansible — vault, retries e senhas de vault
*.retry
.vault_pass*
vault-password*
vault_password*
group_vars/*/vault*
host_vars/*/vault*

# Kubernetes — kubeconfig com credenciais de cluster
kubeconfig
*.kubeconfig
.kube/

# Ambientes virtuais e caches Python
.venv/
venv/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
__pycache__/
*.pyc

# Logs do agente — contêm tokens em URLs (Telegram) e dados operacionais
logs/

# SO
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp
*.swo

# Instruções locais para agentes — não subir ao GitHub
CLAUDE.md

# Alinhamento local — histórico operacional detalhado, não versionado
CHANGELOG.md

# Documentação operacional interna — IPs, credenciais de referência, dados do HomeLAB
docs/hosts.md
docs/postmortem/
docs/runbooks/
