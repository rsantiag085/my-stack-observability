# Zabbix MCP Server — variáveis de ambiente
# Arquivo real: /etc/zabbix-mcp/.env na VM mcp-server (192.168.10.210)
# NÃO commitar o arquivo real — este é apenas o template de referência

# Token da API do Zabbix
# Origem: Zabbix Frontend → Users → API tokens → mcpserver
# Referenciado também na macro global {$MCP_SERVER_KEY} do Zabbix
ZABBIX_API_TOKEN=CHANGE_ME

# Token de autenticação do MCP server (usado pelos clientes MCP)
# Clientes devem enviar: Authorization: Bearer <valor>
MCP_AUTH_TOKEN=CHANGE_ME
