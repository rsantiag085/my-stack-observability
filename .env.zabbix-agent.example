# =============================================================================
# .env.zabbix-agent — Configuração do Agente de Incidentes Zabbix
# =============================================================================
# NUNCA commitar este arquivo com valores reais.
# Copiar para .env.zabbix-agent e preencher os valores.
# Garantir que .env.zabbix-agent está no .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Google Gemini API
# ---------------------------------------------------------------------------
GEMINI_API_KEY=CHANGE_ME
# Modelo padrão: gemini-2.0-flash (free tier: 1.500 req/dia)
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# MCP Server do Zabbix (VM mcp-server — 192.168.10.210)
# O agente conecta ao MCP, descobre as ferramentas automaticamente
# e as usa para diagnosticar e agir nos incidentes.
# ---------------------------------------------------------------------------
ZABBIX_MCP_URL=http://192.168.10.210:8080/mcp
ZABBIX_MCP_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# Loki — fonte de logs para correlação log × métrica (RCA)
# O agente consulta /loki/api/v1/query_range numa janela ao redor da anomalia.
# ---------------------------------------------------------------------------
LOKI_URL=http://192.168.10.104:3100

# ---------------------------------------------------------------------------
# Canal de notificação
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# ---------------------------------------------------------------------------
# Servidor webhook (porta 9001 — não conflita com agent_orchestrator: 9000)
# ---------------------------------------------------------------------------
WEBHOOK_PORT=9001
WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS

# ---------------------------------------------------------------------------
# SSH — execução remota para hosts com Zabbix agent indisponível
# Requer chave SSH sem senha configurada para os hosts do inventário
# ---------------------------------------------------------------------------
SSH_USER=svc-zabbix
SSH_KEY_PATH=/home/robson/.ssh/homelab_ed25519
